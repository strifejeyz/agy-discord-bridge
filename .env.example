# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_USER_ID=123456789012345678

# Antigravity CLI Configuration
AGY_BIN=/home/ubuntu/.local/bin/agy
AGY_WORKSPACE_DIR=/home/ubuntu/agy-discord-bridge/workspace
AGY_EXTRA_DIRS=/var/www,/home/ubuntu

# Local Approval Webhook (between guardrail_hook.py and bot.py)
APPROVAL_HOST=127.0.0.1
APPROVAL_PORT=8765
APPROVAL_TIMEOUT_SECONDS=300
